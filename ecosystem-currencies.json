  "conversion": {
    "policy": "P2P credits (B30C) are converted into project currencies on user demand. Rate is `credit_to_currency_rate` units of the target currency per 1 B30C. Admin can re-tune rates without redeploying.",
    "formula": "target_amount = floor(b30c_credits * project.credit_to_currency_rate)",
    "rounding": "floor",
    "min_credits_per_redemption": 1,
    "max_credits_per_redemption_per_day": 1000,
    "lock_seconds": 0,
    "fee_percent": 0,
    "supports_fractional": false
  },

  "admin": {
    "can_edit_rates": true,
    "can_add_project": true,
    "can_disable_project": true,
    "audit_log": true
  },

  "endpoints": {
    "list_projects":     "GET  /api/ecosystem/projects",
    "get_rates":         "GET  /api/ecosystem/rates",
    "preview_redeem":    "POST /api/ecosystem/preview",
    "redeem_credits":    "POST /api/ecosystem/redeem",
    "admin_set_rate":    "POST /api/admin/ecosystem/rate"
  }
